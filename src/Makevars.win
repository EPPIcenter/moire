# Parallel backend: TBB via RcppParallel (see src/multivector/parallel_backend.h)
PKG_CXXFLAGS += -DRCPP_PARALLEL_USE_TBB=1

PKG_CPPFLAGS += -Imultivector -Iobservation -Iinference -Imcmc -Icore -I.

PKG_LIBS += $(shell "${R_HOME}/bin${R_ARCH_BIN}/Rscript.exe" \
              -e "RcppParallel::RcppParallelLibs()")